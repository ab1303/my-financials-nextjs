{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "My Financials: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev"
    },
    {
      "name": "My Financials: debug client-side",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    },
    {
      "name": "My Financials: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run dev",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Playwright: Debug Current Test",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx playwright test \"${file}\" --debug"
    },
    {
      "name": "Playwright: Debug All E2E",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run test:e2e:debug"
    }
  ]
}
