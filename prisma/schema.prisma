generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String                @id @default(cuid())
  name                  String?
  email                 String?               @unique
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime              @default(now())
  password              String
  role                  RoleEnumType?         @default(user)
  updatedAt             DateTime              @updatedAt
  avatarStorageProvider StorageProviderEnum?
  avatarStorageUrl      String?
  bio                   String?
  fiscalYearType        CalendarEnumType?     @default(FISCAL)
  linkedInUrl           String?
  phone                 String?
  preferredCurrency     CurrencyEnumType?     @default(AUD)
  timezone              String?               @default("Australia/Sydney")
  aiUsageLogs           AIUsageLog[]
  accounts              Account[]
  bankBalanceSnapshots  BankBalanceSnapshot[]
  businesses            Business[]
  categoryRules         CategoryRule[]
  expenseLedgers        ExpenseLedger[]
  financialAccounts     FinancialAccount[]
  importImages          ImportImage[]
  importSessions        ImportSession[]
  individuals           Individual[]
  merchantCategoryMaps  MerchantCategoryMap[]
  portfolioSnapshots    PortfolioSnapshot[]
  relationshipTypes     RelationshipType[]
  sessions              Session[]
  transactions          Transaction[]
  transferMatchRules    TransferMatchRule[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model IncomeSource {
  id          String   @id @default(cuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  description String?
}

model RelationshipType {
  id          String       @id @default(cuid())
  name        String
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  individuals Individual[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
}

model Individual {
  id                 String              @id @default(cuid())
  name               String
  firstName          String?
  lastName           String?
  userId             String
  addressLine        String?
  createdAt          DateTime            @default(now())
  postcode           Int?
  relationshipId     String?
  state              String?
  streetAddress      String?
  suburb             String?
  updatedAt          DateTime            @updatedAt
  addressFormat      String?             @default("AU")
  donationPayments   DonationPayment[]
  relationship       RelationshipType?   @relation(fields: [relationshipId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  voluntaryDonations VoluntaryDonation[]
  zakatPayments      ZakatPayment[]

  @@unique([name, userId])
}

model Business {
  id                       String              @id @default(cuid())
  name                     String
  addressLine              String?
  streetAddress            String?
  suburb                   String?
  postcode                 Int?
  state                    String?
  type                     BusinessEnumType?
  userId                   String?
  isDgrRegistered          Boolean?            @default(false)
  user                     User?               @relation(fields: [userId], references: [id])
  donationPayments         DonationPayment[]
  financialAccounts        FinancialAccount[]
  interestCleansingRecords InterestCleansing[]
  voluntaryDonations       VoluntaryDonation[]
  zakatPayments            ZakatPayment[]
}

model ZakatObligation {
  id         String         @id @default(cuid())
  calendarId String         @unique
  amountDue  Decimal        @db.Decimal(12, 2)
  calendar   CalendarYear   @relation(fields: [calendarId], references: [id])
  payments   ZakatPayment[]
}

model ZakatPayment {
  id                String              @id @default(cuid())
  datePaid          DateTime
  amount            Decimal             @db.Decimal(19, 4)
  beneficiaryType   BeneficiaryEnumType
  businessId        String?
  individualId      String?
  zakatObligationId String
  transactionId     String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  business          Business?           @relation(fields: [businessId], references: [id])
  individual        Individual?         @relation(fields: [individualId], references: [id])
  transaction       Transaction?        @relation(fields: [transactionId], references: [id])
  zakatObligation   ZakatObligation     @relation(fields: [zakatObligationId], references: [id])
}

model DonationLedger {
  id                       String              @id @default(cuid())
  calendarId               String              @unique
  calendar                 CalendarYear        @relation(fields: [calendarId], references: [id])
  payments                 DonationPayment[]
  interestCleansingRecords InterestCleansing[]
  voluntaryDonations       VoluntaryDonation[]
}

model DonationPayment {
  id               String                    @id @default(cuid())
  datePaid         DateTime
  amount           Decimal                   @db.Decimal(19, 4)
  beneficiaryType  BeneficiaryEnumType
  businessId       String?
  individualId     String?
  donationLedgerId String
  donationPurpose  DonationPurposeEnum       @default(VOLUNTARY)
  interestTxId     String?                   @unique
  business         Business?                 @relation(fields: [businessId], references: [id])
  donationLedger   DonationLedger            @relation(fields: [donationLedgerId], references: [id])
  individual       Individual?               @relation(fields: [individualId], references: [id])
  interestTx       Transaction?              @relation("DonationPaymentInterest", fields: [interestTxId], references: [id])
  evidence         DonationPaymentEvidence[]
}

model DonationPaymentEvidence {
  id                    String          @id @default(cuid())
  donationPaymentId     String
  createdAt             DateTime        @default(now())
  amountApplied         Decimal         @db.Decimal(12, 2)
  confidence            Float?          @default(0.0)
  evidenceTransactionId String
  updatedAt             DateTime        @updatedAt
  donationPayment       DonationPayment @relation(fields: [donationPaymentId], references: [id], onDelete: Cascade)
  evidenceTransaction   Transaction     @relation(fields: [evidenceTransactionId], references: [id], onDelete: Cascade)

  @@unique([donationPaymentId, evidenceTransactionId])
  @@index([donationPaymentId])
  @@index([evidenceTransactionId])
}

model VoluntaryDonation {
  id               String                      @id @default(cuid())
  datePaid         DateTime
  amount           Decimal                     @db.Decimal(19, 4)
  beneficiaryType  BeneficiaryEnumType
  businessId       String?
  individualId     String?
  donationLedgerId String
  purpose          DonationPurposeEnum         @default(VOLUNTARY)
  transactionId    String?                     @unique
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  business         Business?                   @relation(fields: [businessId], references: [id])
  donationLedger   DonationLedger              @relation(fields: [donationLedgerId], references: [id])
  individual       Individual?                 @relation(fields: [individualId], references: [id])
  transaction      Transaction?                @relation(fields: [transactionId], references: [id])
}

model InterestCleansing {
  id               String                      @id @default(cuid())
  datePaid         DateTime
  amount           Decimal                     @db.Decimal(19, 4)
  sourceBusinessId String?
  donationLedgerId String
  creditTxId       String?                     @unique
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  creditTx         Transaction?                @relation("InterestCredit", fields: [creditTxId], references: [id])
  donationLedger   DonationLedger              @relation(fields: [donationLedgerId], references: [id])
  sourceBusiness   Business?                   @relation(fields: [sourceBusinessId], references: [id])
  evidence         InterestCleansingEvidence[]
}

model InterestCleansingEvidence {
  id                  String            @id @default(cuid())
  interestCleansingId String
  transactionId       String
  amountLinked        Decimal?          @db.Decimal(19, 4)
  confidence          Float?            @default(0)
  createdAt           DateTime          @default(now())
  interestCleansing   InterestCleansing @relation(fields: [interestCleansingId], references: [id], onDelete: Cascade)
  transaction         Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([interestCleansingId, transactionId])
  @@index([interestCleansingId])
  @@index([transactionId])
}

model MigrationAudit {
  id          String          @id @default(cuid())
  legacyTable String
  legacyId    String
  newTable    String
  newId       String?
  status      MigrationStatus @default(PENDING)
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([legacyTable, legacyId])
}

model SpecialCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  isActive    Boolean  @default(true)
  isEditable  Boolean  @default(false)
  color       String?
  createdAt   DateTime @default(now())
}

model ExpenseCategory {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  iconName                String?
  description             String?
  monthlyExpenseSummaries MonthlyExpenseSummary[]
}

model ExpenseLedger {
  id                      String                  @id @default(cuid())
  calendarId              String
  userId                  String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  calendar                CalendarYear            @relation(fields: [calendarId], references: [id])
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyExpenseSummaries MonthlyExpenseSummary[]

  @@unique([calendarId, userId])
}

model MonthlyExpenseSummary {
  id              String          @id @default(cuid())
  month           Int
  amount          Decimal         @db.Decimal(12, 2)
  categoryId      String
  expenseLedgerId String
  importImageId   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  expenseLedger   ExpenseLedger   @relation(fields: [expenseLedgerId], references: [id], onDelete: Cascade)
  importImage     ImportImage?    @relation(fields: [importImageId], references: [id])

  @@index([expenseLedgerId, month])
}

model CalendarYear {
  id               String            @id @default(cuid())
  description      String
  fromYear         Int
  fromMonth        Int
  toYear           Int
  toMonth          Int
  type             CalendarEnumType?
  lockedAt         DateTime?
  donationLedgers  DonationLedger?
  expenseLedgers   ExpenseLedger[]
  zakatObligations ZakatObligation?
}

model FinancialAccount {
  id                  String                 @id @default(cuid())
  name                String
  institutionId       String
  userId              String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  isTracked           Boolean                @default(true)
  balanceRecords      BankBalanceRecord[]
  cashBalances        BrokerageCashBalance[]
  institution         Business               @relation(fields: [institutionId], references: [id])
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockHoldings       StockHolding[]
  transactions        Transaction[]
  creditTransferRules TransferMatchRule[]    @relation("creditRules")
  debitTransferRules  TransferMatchRule[]    @relation("debitRules")

  @@unique([name, institutionId, userId])
  @@index([userId, institutionId])
}

model BankBalanceSnapshot {
  id             String              @id @default(cuid())
  snapshotDate   DateTime
  userId         String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  balanceRecords BankBalanceRecord[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, snapshotDate])
}

model BankBalanceRecord {
  id            String              @id @default(cuid())
  balance       Decimal             @db.Decimal(12, 2)
  accountId     String
  snapshotId    String
  importImageId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  account       FinancialAccount    @relation(fields: [accountId], references: [id])
  importImage   ImportImage?        @relation(fields: [importImageId], references: [id])
  snapshot      BankBalanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([accountId, snapshotId])
  @@index([snapshotId])
}

model PortfolioSnapshot {
  id           String                 @id @default(cuid())
  snapshotDate DateTime
  userId       String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  usdToAudRate Decimal?
  cashBalances BrokerageCashBalance[]
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     StockHolding[]

  @@index([userId, snapshotDate])
}

model BrokerageCashBalance {
  id         String            @id @default(cuid())
  amount     Decimal           @db.Decimal(12, 2)
  currency   CurrencyEnumType
  accountId  String
  snapshotId String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  account    FinancialAccount  @relation(fields: [accountId], references: [id])
  snapshot   PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([accountId, currency, snapshotId])
  @@index([snapshotId])
  @@index([accountId])
}

model StockHolding {
  id           String                 @id @default(cuid())
  ticker       String
  companyName  String
  quantity     Decimal
  buyPrice     Decimal                @db.Decimal(12, 2)
  buyDate      DateTime?
  currentPrice Decimal                @db.Decimal(12, 2)
  currency     CurrencyEnumType
  plannedTerm  InvestmentTermEnumType
  salePrice    Decimal?               @db.Decimal(12, 2)
  saleDate     DateTime?
  soldQuantity Decimal?
  accountId    String
  snapshotId   String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  account      FinancialAccount       @relation(fields: [accountId], references: [id])
  snapshot     PortfolioSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([accountId])
  @@index([ticker])
}

model ImportSession {
  id                String                   @id @default(cuid())
  userId            String
  importType        ImportTypeEnum
  status            ImportStatusEnum         @default(PENDING)
  overallConfidence Float?
  recordsCreated    Int                      @default(0)
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  endDate           DateTime?
  startDate         DateTime?
  usageLogs         AIUsageLog[]
  images            ImportImage[]
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  matchJobResults   TransferMatchJobResult[]

  @@index([userId, createdAt])
}

model ImportImage {
  id                      String                  @id @default(cuid())
  userId                  String
  sessionId               String
  fileName                String
  fileSize                Int
  mimeType                String
  storageUrl              String
  storageProvider         StorageProviderEnum
  confidence              Float?
  extractedData           Json?
  errorMessage            String?
  createdAt               DateTime                @default(now())
  expiresAt               DateTime?
  bankBalanceRecords      BankBalanceRecord[]
  session                 ImportSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyExpenseSummaries MonthlyExpenseSummary[]

  @@index([sessionId])
  @@index([userId])
}

model AIUsageLog {
  id               String         @id @default(cuid())
  sessionId        String
  userId           String
  imageId          String?
  importType       ImportTypeEnum
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUSD Float
  createdAt        DateTime       @default(now())
  session          ImportSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, importType, createdAt])
  @@index([importType, createdAt])
  @@index([sessionId])
}

model MerchantCategoryMap {
  id          String   @id @default(cuid())
  userId      String
  description String
  category    String
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, description])
  @@index([userId])
}

model Transaction {
  id                          String                      @id @default(cuid())
  date                        DateTime
  description                 String
  amount                      Decimal                     @db.Decimal(12, 2)
  type                        TransactionTypeEnum
  category                    String
  source                      TransactionSourceEnum
  status                      TransactionStatusEnum       @default(PENDING)
  confirmedAt                 DateTime?
  bankAccountId               String?
  userId                      String
  importSessionId             String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  offsetCategory              String?
  offsetTransactionId         String?
  preLinkCategory             String?
  preLinkStatus               TransactionStatusEnum?
  transferLinkedTransactionId String?                     @unique
  preVoidStatus               TransactionStatusEnum?
  runningBalance              Decimal?                    @db.Decimal(12, 2)
  orphanResolution            TransferOrphanResolution?
  donationPaymentInterest     DonationPayment?            @relation("DonationPaymentInterest")
  donationPaymentEvidence     DonationPaymentEvidence[]
  interestCleansingCredit     InterestCleansing?          @relation("InterestCredit")
  interestCleansingEvidence   InterestCleansingEvidence[]
  financialAccount            FinancialAccount?           @relation(fields: [bankAccountId], references: [id])
  importSession               ImportSession?              @relation(fields: [importSessionId], references: [id])
  offsetTransaction           Transaction?                @relation("ReimbursementLink", fields: [offsetTransactionId], references: [id])
  reimbursements              Transaction[]               @relation("ReimbursementLink")
  transferLinkedTransaction   Transaction?                @relation("TransferLink", fields: [transferLinkedTransactionId], references: [id])
  transferCounterpart         Transaction?                @relation("TransferLink")
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  zakatPayment                ZakatPayment?
  voluntaryDonations          VoluntaryDonation[]

  @@index([userId, date, id])
  @@index([userId, bankAccountId, date])
  @@index([userId, type, status])
  @@index([importSessionId])
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model TransferMatchRule {
  id                  String                   @id @default(cuid())
  userId              String
  name                String
  isActive            Boolean                  @default(true)
  amountExact         Decimal?                 @db.Decimal(12, 2)
  amountMin           Decimal?                 @db.Decimal(12, 2)
  amountMax           Decimal?                 @db.Decimal(12, 2)
  debitKeywords       String[]
  creditKeywords      String[]
  maxDayGap           Int                      @default(5)
  debitBankAccountId  String?
  creditBankAccountId String?
  confidenceThreshold Int                      @default(85)
  matchCount          Int                      @default(0)
  lastMatchedAt       DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  jobResults          TransferMatchJobResult[]
  creditBankAccount   FinancialAccount?        @relation("creditRules", fields: [creditBankAccountId], references: [id])
  debitBankAccount    FinancialAccount?        @relation("debitRules", fields: [debitBankAccountId], references: [id])
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model TransferMatchJobResult {
  id              String             @id @default(cuid())
  userId          String
  importSessionId String
  ruleId          String?
  autoLinkedCount Int                @default(0)
  flaggedCount    Int                @default(0)
  skippedCount    Int                @default(0)
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  importSession   ImportSession      @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  rule            TransferMatchRule? @relation(fields: [ruleId], references: [id])

  @@index([userId, importSessionId])
}

model CategoryRule {
  id           String                @id @default(cuid())
  userId       String
  name         String
  matchType    CategoryRuleMatchType @default(CONTAINS)
  pattern      String
  category     String
  isActive     Boolean               @default(true)
  appliedCount Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

enum RoleEnumType {
  user
  admin
}

enum BusinessEnumType {
  BANK
  PHILANTHROPY
  BROKERAGE
}

enum BeneficiaryEnumType {
  INDIVIDUAL
  BUSINESS
}

enum DonationPurposeEnum {
  VOLUNTARY
  INTEREST_CLEANSING
  ZAKAT
}

enum TaxCategoryEnumType {
  DEDUCTIBLE
  NON_DEDUCTIBLE
}

enum CalendarEnumType {
  ZAKAT
  ANNUAL
  FISCAL
}

enum InvestmentTermEnumType {
  SHORT_TERM
  MID_TERM
  LONG_TERM
}

enum CurrencyEnumType {
  AUD
  USD
}

enum MigrationStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

enum ImportTypeEnum {
  EXPENSE
  BANK_ASSET
  STOCK
}

enum ImportStatusEnum {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  VOIDED
}

enum StorageProviderEnum {
  LOCAL
  S3
}

enum TransactionTypeEnum {
  DEBIT
  CREDIT
}

enum TransactionSourceEnum {
  LLM_CLASSIFIED
  USER_OVERRIDE
  USER_MANUAL
}

enum TransactionStatusEnum {
  PENDING
  CONFIRMED
  EXCLUDED
  VOIDED
}

enum TransferOrphanResolution {
  EXCLUDED
  EXPENSE
  INCOME
}

enum CategoryRuleMatchType {
  CONTAINS
  STARTS_WITH
  EXACT
}
